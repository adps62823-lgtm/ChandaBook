# MongoDB Connection URI (100% Free MongoDB Atlas M0 Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/durga_puja_chanda_sasaram?retryWrites=true&w=majority
# If left empty, the application runs seamlessly using built-in local store!
MONGODB_URI=

# Optional: Next.js Port (defaults to 3000)
PORT=3000
